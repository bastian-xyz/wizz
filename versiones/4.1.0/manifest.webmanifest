{
  "name": "XYZ·MAKER · C.I.D.",
  "short_name": "(X,Y,Z)",
  "description": "Central de Implementación y Desarrollo: CUBIK, Ensambles, Bandejas, Mobiliario, Plegadora, DRAFT y herramientas extras.",
  "lang": "es-CL",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b1119",
  "theme_color": "#0b1119",
  "categories": [
    "productivity",
    "business",
    "utilities"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Pedidos",
      "url": "./#pedidos",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Plegadora",
      "url": "./#plegadora",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "CUBIK",
      "url": "./#cubicador",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "DRAFT",
      "url": "./#draft",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./?abrir=1",
      "accept": {
        "application/dxf": [
          ".dxf"
        ],
        "image/vnd.dxf": [
          ".dxf"
        ],
        "model/step": [
          ".step",
          ".stp"
        ],
        "model/iges": [
          ".iges",
          ".igs"
        ],
        "application/octet-stream": [
          ".brep",
          ".cdxf"
        ]
      },
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}